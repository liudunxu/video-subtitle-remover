# syntax=docker/dockerfile:1.7

FROM pytorch/pytorch:2.8.0-cuda12.6-cudnn9-runtime

ARG DEBIAN_FRONTEND=noninteractive
ARG PADDLE_VERSION=3.0.0
ARG PADDLEX_VERSION=3.4.0
ARG ONNXRUNTIME_GPU_VERSION=1.22.0
ARG PADDLE_CUDA_INDEX=https://www.paddlepaddle.org.cn/packages/stable/cu126/

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PATH=/opt/conda/bin:$PATH \
    HOST=0.0.0.0 \
    PORT=6006 \
    HOME=/workspace \
    XDG_CACHE_HOME=/workspace/.cache \
    MPLCONFIGDIR=/workspace/.cache/matplotlib \
    VSR_API_WORK_DIR=/workspace/video_subtitle_remover_api \
    VSR_REQUIRE_GPU=1 \
    PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=True \
    FLAGS_cudnn_deterministic=1 \
    FLAGS_cudnn_exhaustive_search=0

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    ffmpeg \
    git \
    libdbus-1-3 \
    libegl1 \
    libgl1 \
    libglib2.0-0 \
    libgomp1 \
    libsm6 \
    libxext6 \
    libxkbcommon0 \
    libxrender1 \
    && rm -rf /var/lib/apt/lists/*

RUN python --version \
    && python -m pip install --upgrade pip setuptools wheel

WORKDIR /app

COPY requirements.txt pyproject.toml README.md api.py /app/
COPY backend/ /app/backend/
COPY docker/entrypoint-api-gpu.sh /usr/local/bin/vsr-api-gpu-entrypoint

RUN chmod +x /usr/local/bin/vsr-api-gpu-entrypoint \
    && chmod +x /app/backend/ffmpeg/linux_x64/ffmpeg

# PaddleOCR 3.4.0 uses PaddleX internally, so PaddleX is pinned near that stack
# instead of floating to the latest release. PyTorch/torchvision come from the
# base image and are checked below.
RUN python -m pip install \
    paddlepaddle-gpu==${PADDLE_VERSION} \
    --extra-index-url ${PADDLE_CUDA_INDEX}

RUN python -m pip install \
    onnxruntime-gpu==${ONNXRUNTIME_GPU_VERSION} \
    paddlex==${PADDLEX_VERSION} \
    -r requirements.txt

RUN python -m pip install --force-reinstall "numpy==1.26.4"

# Paddle 3.0's wheel metadata pins older CUDA Python packages than the PyTorch
# 2.8 CUDA 12.6 image. Restore PyTorch's exact runtime library pins after Paddle
# is installed; the entrypoint verifies both frameworks on a real GPU at start.
RUN python -m pip install --force-reinstall --no-deps \
    nvidia-cudnn-cu12==9.10.2.21 \
    nvidia-cusparselt-cu12==0.7.1 \
    nvidia-nccl-cu12==2.27.3

RUN mkdir -p /workspace/.cache/matplotlib /workspace/video_subtitle_remover_api

# Docker builds do not expose libcuda.so.1, so do not import Paddle here. The
# entrypoint performs strict torch/Paddle/ONNX GPU checks on the Vast.ai host.
RUN python - <<'PY'
from importlib import metadata

import onnxruntime as ort
import torch

if not torch.__version__.startswith("2.8.0"):
    raise SystemExit(f"unexpected torch version: {torch.__version__}")
if not torch.version.cuda:
    raise SystemExit("torch is not a CUDA build")
providers = ort.get_available_providers()
if "CUDAExecutionProvider" not in providers:
    raise SystemExit(f"onnxruntime-gpu CUDA provider missing: {providers}")

print("GPU package checks passed:")
print(f"  torch={torch.__version__} cuda={torch.version.cuda}")
print(f"  paddlepaddle-gpu={metadata.version('paddlepaddle-gpu')}")
print(f"  onnxruntime_providers={providers}")
print(f"  paddleocr={metadata.version('paddleocr')}")
print(f"  paddlex={metadata.version('paddlex')}")
PY

EXPOSE 6006

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD python -c "import os, urllib.request; urllib.request.urlopen('http://127.0.0.1:%s/health' % os.environ.get('PORT', '6006'), timeout=3).read()"

ENTRYPOINT ["/usr/local/bin/vsr-api-gpu-entrypoint"]
